generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum SeatType {
  REGULAR
  PREMIUM
  RECLINER
}

enum ShowStatus {
  SCHEDULED
  CANCELLED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUND_PENDING
  REFUNDED
}

enum RefundStatus {
  PENDING
  REFUNDED
}

enum RefundAttemptStatus {
  REQUESTED
  PENDING
  FAILED
  PROCESSED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(100)
  email        String   @unique @db.VarChar(254)
  passwordHash String?  @map("password_hash") @db.VarChar(60)
  googleSubject String? @unique @map("google_subject") @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  authDisabledAt DateTime? @map("auth_disabled_at") @db.Timestamptz(3)
  authVersion Int @default(0) @map("auth_version")
  quarantinedAccount AccountQuarantine? @relation("QuarantinedUser")
  replacementAccount AccountQuarantine? @relation("ReplacementUser")
  role         UserRole @default(USER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  bookings     Booking[]
  dateOfBirth  DateTime? @map("date_of_birth") @db.Date
  phone        String? @db.VarChar(20)
  avatarUrl    String? @map("avatar_url")
  avatarPublicId String? @map("avatar_public_id")
  wishlist     MovieWishlist[]
  firstBookingOffer FirstBookingOffer?

  @@map("users")
}

model AccountQuarantine {
  id String @id @default(uuid()) @db.Uuid
  originalUserId String @unique @map("original_user_id") @db.Uuid
  replacementUserId String @unique @map("replacement_user_id") @db.Uuid
  originalEmail String @map("original_email") @db.VarChar(254)
  reason String @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  originalUser User @relation("QuarantinedUser", fields: [originalUserId], references: [id], onDelete: Restrict)
  replacementUser User @relation("ReplacementUser", fields: [replacementUserId], references: [id], onDelete: Restrict)

  @@map("account_quarantines")
}

model Movie {
  id              String   @id @default(uuid()) @db.Uuid
  title           String   @db.VarChar(200)
  description     String
  descriptionHindi String? @map("description_hindi")
  trailerVideoId String? @map("trailer_video_id") @db.VarChar(11)
  trailerSourceUrl String? @map("trailer_source_url")
  trailerVerifiedAt DateTime? @map("trailer_verified_at") @db.Timestamptz(3)
  durationMinutes Int      @map("duration_minutes")
  releaseDate     DateTime @map("release_date") @db.Date
  language        String   @db.VarChar(50)
  genres          String[]
  posterUrl       String?  @map("poster_url")
  backdropUrl     String?  @map("backdrop_url")
  collections     String[] @default([])
  metadataSourceUrl String? @map("metadata_source_url")
  artworkKind     String? @map("artwork_kind") @db.VarChar(30)
  artworkAttribution String? @map("artwork_attribution")
  artworkSourceUrl String? @map("artwork_source_url")
  ratingValue     Float? @map("rating_value")
  ratingVoteCount Int? @map("rating_vote_count")
  ratingSource    String? @map("rating_source") @db.VarChar(30)
  ratingSourceUrl String? @map("rating_source_url")
  ratingFetchedAt DateTime? @map("rating_fetched_at") @db.Timestamptz(3)
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  shows           Show[]
  wishlistedBy    MovieWishlist[]

  @@index([isActive, title, id])
  @@index([isActive, language])
  @@index([genres], type: Gin)
  @@index([collections], type: Gin)
  @@map("movies")
}

model MovieWishlist {
  userId    String @map("user_id") @db.Uuid
  movieId   String @map("movie_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@id([userId, movieId])
  @@index([userId, createdAt, movieId])
  @@map("movie_wishlists")
}

model City {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.Citext
  state       String    @db.Citext
  countryCode String    @default("IN") @map("country_code") @db.Char(2)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  theatres    Theatre[]
  eventVenues EventVenue[]

  @@unique([countryCode, state, name])
  @@index([name, id])
  @@map("cities")
}

enum EventKind {
  EVENTS
  SPORTS
  ACTIVITIES
}

enum EventVenueKind {
  AUDITORIUM
  STADIUM
  ARENA
}

enum EventTicketTier {
  STANDARD
  PREMIUM
  VIP
}

enum EventSessionStatus {
  SCHEDULED
  CANCELLED
}

model Event {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique @db.VarChar(200)
  title String @db.VarChar(200)
  description String
  kind EventKind
  sport String? @db.VarChar(50)
  durationMinutes Int @map("duration_minutes")
  imageUrl String? @map("image_url")
  imageAttribution String? @map("image_attribution")
  isSample Boolean @default(true) @map("is_sample")
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  performers EventPerformer[]
  participants EventParticipant[]
  sessions EventSession[]
  @@index([isActive, kind, title, id])
  @@map("events")
}

model EventPerformer {
  eventId String @map("event_id") @db.Uuid
  name String @db.VarChar(100)
  biography String
  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  @@id([eventId, name])
  @@map("event_performers")
}

model EventParticipant {
  eventId String @map("event_id") @db.Uuid
  name String @db.VarChar(100)
  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  @@id([eventId, name])
  @@map("event_participants")
}

model EventVenue {
  id String @id @default(uuid()) @db.Uuid
  cityId String @map("city_id") @db.Uuid
  name String @db.Citext
  address String @db.VarChar(500)
  kind EventVenueKind
  capacity Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  city City @relation(fields: [cityId], references: [id], onDelete: Restrict)
  sections EventSection[]
  sessions EventSession[]
  @@unique([cityId, name])
  @@map("event_venues")
}

model EventSection {
  id String @id @default(uuid()) @db.Uuid
  venueId String @map("venue_id") @db.Uuid
  code String @db.VarChar(30)
  name String @db.VarChar(100)
  position String @db.VarChar(10)
  sortOrder Int @map("sort_order")
  venue EventVenue @relation(fields: [venueId], references: [id], onDelete: Restrict)
  seats EventSeat[]
  @@unique([venueId, code])
  @@unique([id, venueId])
  @@index([venueId, sortOrder, id])
  @@map("event_sections")
}

model EventSeat {
  id String @id @default(uuid()) @db.Uuid
  sectionId String @map("section_id") @db.Uuid
  rowName String @map("row_name") @db.VarChar(10)
  seatNumber Int @map("seat_number")
  ticketTier EventTicketTier @map("ticket_tier")
  section EventSection @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  bookingSeats EventBookingSeat[]
  @@unique([sectionId, rowName, seatNumber])
  @@unique([id, sectionId])
  @@map("event_seats")
}

model EventSession {
  id String @id @default(uuid()) @db.Uuid
  eventId String @map("event_id") @db.Uuid
  venueId String @map("venue_id") @db.Uuid
  startsAt DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt DateTime @default(dbgenerated()) @map("ends_at") @db.Timestamptz(3)
  status EventSessionStatus @default(SCHEDULED)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  event Event @relation(fields: [eventId], references: [id], onDelete: Restrict)
  venue EventVenue @relation(fields: [venueId], references: [id], onDelete: Restrict)
  prices EventSessionPrice[]
  bookings Booking[]
  bookingSeats EventBookingSeat[]
  @@unique([id, venueId])
  @@index([eventId, startsAt, id])
  @@index([venueId, startsAt, id])
  @@index([status, startsAt, id])
  @@map("event_sessions")
}

model EventSessionPrice {
  sessionId String @map("session_id") @db.Uuid
  ticketTier EventTicketTier @map("ticket_tier")
  pricePaise Int @map("price_paise")
  session EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  @@id([sessionId, ticketTier])
  @@map("event_session_prices")
}

model Theatre {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.Citext
  address   String   @db.VarChar(500)
  cityId    String   @map("city_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  city      City     @relation(fields: [cityId], references: [id], onDelete: Restrict)
  screens   Screen[]

  @@unique([cityId, name])
  @@index([name, id])
  @@map("theatres")
}

model Screen {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.Citext
  capacity  Int
  theatreId String   @map("theatre_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  theatre   Theatre  @relation(fields: [theatreId], references: [id], onDelete: Restrict)
  seats     Seat[]
  shows     Show[]

  @@unique([theatreId, name])
  @@map("screens")
}

model Seat {
  id         String   @id @default(uuid()) @db.Uuid
  screenId   String   @map("screen_id") @db.Uuid
  rowName    String   @map("row_name") @db.VarChar(10)
  seatNumber Int      @map("seat_number")
  seatType   SeatType @map("seat_type")
  screen     Screen   @relation(fields: [screenId], references: [id], onDelete: Restrict)
  bookingSeats BookingSeat[]

  @@unique([screenId, rowName, seatNumber])
  @@map("seats")
}

model Show {
  id        String     @id @default(uuid()) @db.Uuid
  movieId   String     @map("movie_id") @db.Uuid
  screenId  String     @map("screen_id") @db.Uuid
  startsAt  DateTime   @map("starts_at") @db.Timestamptz(3)
  endsAt    DateTime   @map("ends_at") @db.Timestamptz(3)
  status    ShowStatus @default(SCHEDULED)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  movie     Movie      @relation(fields: [movieId], references: [id], onDelete: Restrict)
  screen    Screen     @relation(fields: [screenId], references: [id], onDelete: Restrict)
  prices    ShowSeatPrice[]
  bookings  Booking[]

  @@index([movieId, startsAt, id])
  @@index([screenId, startsAt, id])
  @@index([startsAt, id])
  @@map("shows")
}

enum BookingKind {
  MOVIE
  EVENT
}

model Booking {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  bookingKind BookingKind   @default(MOVIE) @map("booking_kind")
  showId      String?       @map("show_id") @db.Uuid
  eventSessionId String?    @map("event_session_id") @db.Uuid
  status      BookingStatus @default(PENDING)
  totalPaise  BigInt        @map("total_paise")
  pricingVersion Int @default(0) @map("pricing_version")
  pricingQuote BookingPricingQuote?
  firstOfferReservation FirstBookingOffer?
  expiresAt   DateTime      @map("expires_at") @db.Timestamptz(3)
  confirmedAt DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  failureCode String?       @map("failure_code") @db.VarChar(100)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  user        User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  show        Show?         @relation(fields: [showId], references: [id], onDelete: Restrict)
  eventSession EventSession? @relation(fields: [eventSessionId], references: [id], onDelete: Restrict)
  seats       BookingSeat[]
  eventSeats  EventBookingSeat[]
  payment     Payment?

  @@unique([id, showId])
  @@unique([id, eventSessionId])
  @@index([userId, createdAt, id])
  @@index([status, expiresAt])
  @@index([showId])
  @@index([eventSessionId])
  @@map("bookings")
}

model BookingPricingQuote {
  bookingId String @id @map("booking_id") @db.Uuid
  couponCode String? @map("coupon_code") @db.VarChar(20)
  subtotalPaise BigInt @map("subtotal_paise")
  discountPaise BigInt @map("discount_paise")
  finalPaise BigInt @map("final_paise")
  breakdown Json
  frozenAt DateTime? @map("frozen_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  booking Booking @relation(fields:[bookingId],references:[id],onDelete:Restrict)
  @@map("booking_pricing_quotes")
}

model FirstBookingOffer {
  userId String @id @map("user_id") @db.Uuid
  reservedBookingId String? @unique @map("reserved_booking_id") @db.Uuid
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  user User @relation(fields:[userId],references:[id],onDelete:Restrict)
  booking Booking? @relation(fields:[reservedBookingId],references:[id],onDelete:Restrict)
  @@map("first_booking_offers")
}

// Only operator-reviewed policies. No browser writes; missing policy blocks checkout.
model PricingTaxPolicy {
  key String @id @db.VarChar(100)
  settings Json
  verifiedBy String @map("verified_by") @db.VarChar(200)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  @@map("pricing_tax_policies")
}

model EventBookingSeat {
  id String @id @default(uuid()) @db.Uuid
  bookingId String @map("booking_id") @db.Uuid
  eventSessionId String @map("event_session_id") @db.Uuid
  eventSeatId String @map("event_seat_id") @db.Uuid
  price Int
  booking Booking @relation(fields: [bookingId, eventSessionId], references: [id, eventSessionId], onDelete: Cascade)
  session EventSession @relation(fields: [eventSessionId], references: [id], onDelete: Restrict)
  seat EventSeat @relation(fields: [eventSeatId], references: [id], onDelete: Restrict)
  allocation EventConfirmedSeat?
  @@unique([id, eventSessionId, eventSeatId])
  @@unique([bookingId, eventSeatId])
  @@index([eventSeatId])
  @@map("event_booking_seats")
}

model EventConfirmedSeat {
  sessionId String @map("session_id") @db.Uuid
  seatId String @map("seat_id") @db.Uuid
  bookingSeatId String @unique @map("booking_seat_id") @db.Uuid
  bookingSeat EventBookingSeat @relation(fields: [bookingSeatId, sessionId, seatId], references: [id, eventSessionId, eventSeatId], onDelete: Cascade)
  @@id([sessionId, seatId])
  @@unique([bookingSeatId, sessionId, seatId])
  @@map("event_confirmed_seats")
}

model Payment {
  id                 String @id @default(uuid()) @db.Uuid
  bookingId          String @unique @map("booking_id") @db.Uuid
  receipt            String @unique @db.VarChar(40)
  amountPaise        BigInt @map("amount_paise")
  currency           String @default("INR") @db.VarChar(3)
  providerOrderId    String? @unique @map("provider_order_id") @db.VarChar(100)
  status             PaymentStatus @default(PENDING)
  providerPaymentId  String? @unique @map("provider_payment_id") @db.VarChar(100)
  capturedAt         DateTime? @map("captured_at") @db.Timestamptz(3)
  bookingFinalizedAt DateTime? @map("booking_finalized_at") @db.Timestamptz(3)
  failureCode        String? @map("failure_code") @db.VarChar(100)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  booking            Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  evidence           PaymentEvidence[]
  events             PaymentWebhookEvent[]
  reconciliation     PaymentReconciliation?
  refunds            Refund[]

  @@index([status, bookingFinalizedAt])
  @@map("payments")
}

model PaymentEvidence {
  providerPaymentId String @id @map("provider_payment_id") @db.VarChar(100)
  paymentId         String @map("payment_id") @db.Uuid
  amountPaise       BigInt @map("amount_paise")
  currency          String @default("INR") @db.VarChar(3)
  captured          Boolean @default(false)
  failureSeen       Boolean @default(false) @map("failure_seen")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  payment           Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  refund            Refund?

  @@index([paymentId])
  @@map("payment_evidence")
}

model PaymentWebhookEvent {
  providerEventId   String @id @map("provider_event_id") @db.VarChar(100)
  digest            String @db.Char(64)
  eventType         String @map("event_type") @db.VarChar(60)
  paymentId         String? @map("payment_id") @db.Uuid
  providerPaymentId String? @map("provider_payment_id") @db.VarChar(100)
  providerRefundId  String? @map("provider_refund_id") @db.VarChar(100)
  processedAt       DateTime? @map("processed_at") @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  payment           Payment? @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_webhook_events")
}

model PaymentReconciliation {
  id                   String @id @default(uuid()) @db.Uuid
  paymentId            String @unique @map("payment_id") @db.Uuid
  reason               String @db.VarChar(100)
  compensationRequired Boolean @default(false) @map("compensation_required")
  resolvedAt           DateTime? @map("resolved_at") @db.Timestamptz(3)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  payment              Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("payment_reconciliations")
}

model Refund {
  id                String @id @default(uuid()) @db.Uuid
  paymentId         String @map("payment_id") @db.Uuid
  providerPaymentId String @unique @map("provider_payment_id") @db.VarChar(100)
  amountPaise       BigInt @map("amount_paise")
  currency          String @default("INR") @db.VarChar(3)
  reason            String @db.VarChar(100)
  status            RefundStatus @default(PENDING)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  payment           Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  source            PaymentEvidence @relation(fields: [providerPaymentId], references: [providerPaymentId], onDelete: Restrict)
  attempts          RefundAttempt[]

  @@index([paymentId])
  @@index([status, createdAt])
  @@map("refunds")
}

model RefundAttempt {
  id               String @id @default(uuid()) @db.Uuid
  refundId         String @map("refund_id") @db.Uuid
  sequence         Int
  receipt          String @unique @db.VarChar(40)
  providerRefundId String? @unique @map("provider_refund_id") @db.VarChar(100)
  status           RefundAttemptStatus @default(REQUESTED)
  lastErrorCode    String? @map("last_error_code") @db.VarChar(100)
  processedAt      DateTime? @map("processed_at") @db.Timestamptz(3)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  refund           Refund @relation(fields: [refundId], references: [id], onDelete: Restrict)

  @@unique([refundId, sequence])
  @@map("refund_attempts")
}

model BookingSeat {
  id        String @id @default(uuid()) @db.Uuid
  bookingId String @map("booking_id") @db.Uuid
  showId    String @map("show_id") @db.Uuid
  seatId    String @map("seat_id") @db.Uuid
  price     Int
  booking   Booking @relation(fields: [bookingId, showId], references: [id, showId], onDelete: Cascade)
  seat      Seat    @relation(fields: [seatId], references: [id], onDelete: Restrict)
  allocation ConfirmedSeat?

  @@unique([id, showId, seatId])
  @@unique([bookingId, seatId])
  @@index([seatId])
  @@map("booking_seats")
}

model ConfirmedSeat {
  showId        String @map("show_id") @db.Uuid
  seatId        String @map("seat_id") @db.Uuid
  bookingSeatId String @unique @map("booking_seat_id") @db.Uuid
  bookingSeat   BookingSeat @relation(fields: [bookingSeatId, showId, seatId], references: [id, showId, seatId], onDelete: Cascade)

  @@id([showId, seatId])
  @@unique([bookingSeatId, showId, seatId])
  @@map("confirmed_seats")
}

model ShowSeatPrice {
  showId     String   @map("show_id") @db.Uuid
  seatType   SeatType @map("seat_type")
  pricePaise Int      @map("price_paise")
  show       Show     @relation(fields: [showId], references: [id], onDelete: Cascade)

  @@id([showId, seatType])
  @@map("show_seat_prices")
}

enum DemoListingKind {
  STREAM
  EVENTS
  SPORTS
  ACTIVITIES
}

// Read-only fictional development catalogue; deliberately no Booking relation.
model DemoListing {
  id String @id @default(uuid()) @db.Uuid
  slug String @unique @db.VarChar(100)
  kind DemoListingKind
  title String @db.VarChar(200)
  description String
  category String @db.VarChar(60)
  cityName String? @map("city_name") @db.VarChar(100)
  venueName String? @map("venue_name") @db.VarChar(150)
  startsAt DateTime? @map("starts_at") @db.Timestamptz(3)
  durationMinutes Int? @map("duration_minutes")
  imageUrl String @map("image_url")
  imageAttribution String @map("image_attribution")
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([kind, isActive, category, id])
  @@map("demo_listings")
}
