# Copy to backend/.env.staging (already ignored). Fill privately; never send secrets in chat.
STAGING_IMPORT_ENV=staging
# Use a DIRECT Neon endpoint, SSL verification, and the existing staging application role.
STAGING_DATABASE_URL=
STAGING_EXPECTED_HOST=
STAGING_EXPECTED_DATABASE=
STAGING_EXPECTED_ROLE=
STAGING_BACKEND_ORIGIN=https://cinehook.onrender.com
# Separately set STAGING_CATALOGUE_MODE=true in Render and deploy the prepared guard.
