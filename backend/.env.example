# Copy to backend/.env for local development. These are local-only examples.
NODE_ENV=development
MAINTENANCE_MODE=false
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
# Auth OTP only. Leave empty until ingress CIDRs AND forwarded-header sanitization
# are verified for Render and any Vercel egress. Never use /0 or broad guesses.
AUTH_TRUSTED_PROXY_CIDRS=
# Hosted fallback when inbound proxy trust cannot be established. Network is the
# unchanged default. mailbox-budget ignores IP and enforces mailbox + UTC budget.
AUTH_OTP_RATE_LIMIT_MODE=network
AUTH_OTP_DAILY_EMAIL_BUDGET=240
DATABASE_URL=postgresql://cinehook:cinehook_local@localhost:5432/cinehook
REDIS_URL=redis://localhost:6379
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=86400

# Optional password recovery over Brevo HTTPS API. Verify the sender in Brevo.
BREVO_API_KEY=
PASSWORD_RESET_FROM=
PASSWORD_RESET_FROM_NAME=CineHook

# Optional public web OAuth client ID. Missing means Google sign-in unavailable.
GOOGLE_CLIENT_ID=
# Optional server-only token for guarded TMDB image/rating/official-trailer import.
# Add an approved TMDB logo at frontend/public/provider-assets/tmdb-logo.svg.
# Key setup and separate licensing checklist: docs/provider-setup.md.
TMDB_READ_ACCESS_TOKEN=

# Generate JWT_SECRET locally with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the result in your ignored backend/.env. There is no default signing key.

# Optional as a complete group. Without these, Payment endpoints fail closed.
# Set API credentials from your Razorpay dashboard. The webhook secret is
# a separate strong secret configured on the dashboard webhook endpoint.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
DEV_RAZORPAY_TEST_CHECKOUT=false

# Deployed TEST-only mode. Keep false until Render has TEST-only Razorpay
# credentials, a webhook secret, and the exact approved staging fingerprint.
# STAGING_CATALOGUE_MODE must also remain true. Never use rzp_live_ credentials.
STAGING_CATALOGUE_MODE=false
STAGING_RAZORPAY_TEST_CHECKOUT=false

# Optional as a complete group. Without these, avatar uploads fail closed.
# Keep Cloudinary credentials in the backend only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Never put secrets in frontend VITE_* variables: they are public in the browser.
