{
  "name": "cinehook-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.seed.json",
    "start": "node dist/server.js",
    "start:maintenance": "node dist/maintenance-bridge.js",
    "test": "vitest run",
    "test:smoke": "node --test tests/runtime-smoke.mjs",
    "test:integration": "node --test tests/auth.integration.mjs tests/google-auth.integration.mjs tests/catalog.integration.mjs tests/shows.integration.mjs tests/booking-database.integration.mjs tests/seat-lock.integration.mjs tests/booking.integration.mjs tests/payments-database.integration.mjs tests/payments.integration.mjs tests/refunds-database.integration.mjs tests/refunds.integration.mjs tests/profile-wishlist.integration.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed:dev": "tsx scripts/dev-launch.ts seed",
    "catalog:import:tmdb": "tsx prisma/dev-tmdb-import.ts",
    "catalog:ratings:tmdb": "tsx prisma/dev-tmdb-ratings.ts",
    "dev:catalog:expand": "tsx prisma/dev-tmdb-expansion.ts",
    "dev:catalog:upcoming": "tsx prisma/dev-tmdb-upcoming.ts",
    "dev:catalog:refresh": "tsx prisma/dev-tmdb-upcoming.ts",
    "dev:catalog:hindi": "tsx prisma/dev-tmdb-hindi.ts",
    "dev:locations:seed": "tsx prisma/dev-browse-cities.ts",
    "dev:movie:shows": "tsx prisma/dev-complete-movie-shows.ts",
    "dev:large-halls": "tsx prisma/dev-large-halls.ts",
    "dev:content:seed": "tsx prisma/refinement-seed.ts",
    "dev:events:seed": "tsx prisma/event-seed.ts",
    "dev:db:check": "tsx scripts/dev-launch.ts check",
    "dev:pricing:configure": "tsx scripts/dev-pricing-tax.ts",
    "dev:pricing:simulate": "tsx scripts/dev-pricing-simulation.ts",
    "staging:pricing:sync": "tsx scripts/staging-test-pricing.ts",
    "test:pricing:integration": "node tests/pricing-verify.mjs",
    "dev:db:migrate": "tsx scripts/dev-launch.ts migrate",
    "dev:populated": "tsx scripts/dev-launch.ts start",
    "dev:billing-preview": "tsx scripts/dev-launch.ts start --billing-preview",
    "dev:razorpay-test": "tsx scripts/dev-launch.ts start --razorpay-test",
    "staging:catalogue:plan": "tsx scripts/staging-catalogue.ts --offline-plan",
    "staging:catalogue:dry-run": "tsx scripts/staging-catalogue.ts --dry-run",
    "staging:catalogue:apply": "tsx scripts/staging-catalogue.ts --apply",
    "test:staging:integration": "node --import tsx tests/staging-import.integration.mjs",
    "test:staging:parity": "node --import tsx tests/staging-parity.integration.mjs",
    "test:seed:integration": "tsx --test tests/dev-seed.integration.ts",
    "test:google:integration": "node --test tests/google-auth.integration.mjs",
    "test:ownership:migration": "node --test tests/auth-ownership-migration.integration.mjs",
    "test:ownership:integration": "node --import tsx --test --test-concurrency=1 tests/ownership-concurrency.integration.mjs tests/ownership-financial-history.integration.mjs tests/ownership-flow.integration.mjs tests/ownership-http.integration.mjs tests/ownership-login-races.integration.mjs tests/ownership-proof.integration.mjs tests/ownership-repository.integration.mjs",
    "test:refinement:integration": "tsx --test tests/refinement.integration.ts",
    "test:events:seed:integration": "tsx --test --test-concurrency=1 tests/event-seed.integration.ts",
    "test:events:inventory:integration": "node --test --test-concurrency=1 tests/event-inventory.integration.mjs",
    "test:events:booking:integration": "node --test --test-concurrency=1 tests/event-booking.integration.mjs",
    "test:verify:native": "node tests/refinement-verify.mjs",
    "test:ui:integration": "node --test --test-concurrency=1 tests/ui-browser-native.integration.mjs",
    "test:ui:browser": "node tests/ui-browser-server.mjs"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "google-auth-library": "^11.2.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "redis": "^6.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "prisma": "^7.10.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
