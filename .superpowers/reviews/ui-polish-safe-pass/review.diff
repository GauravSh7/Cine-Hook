+      <p className="mt-2">{show.screen.theatre.name}, {show.screen.theatre.city.name}</p><p className="muted mt-1 text-sm">{show.screen.name}</p>
+    </div></div><div className="divider" />
+    <dl className="grid grid-cols-2 gap-5 md:grid-cols-4"><div><dt className="muted text-xs">Show date / time</dt><dd className="mt-1 font-semibold">{formatDateTime(show.startsAt)}</dd></div>
+      <div><dt className="muted text-xs">Seats</dt><dd className="mt-1 font-semibold">{booking.seats.map(seat => `${seat.rowName}${seat.seatNumber}`).join(', ')}</dd></div>
