+    finish(new Response(JSON.stringify({ success: false, error: { code: 'UNAUTHORIZED', message: 'Authentication is required.', requestId: 'late' } }), { status: 401, headers: { Date: 'Wed, 07 Oct 2026 10:00:00 GMT' } }))
