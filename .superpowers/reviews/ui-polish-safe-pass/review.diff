+.listing-availability .btn { flex-shrink: 0; }
+@keyframes page-enter { from { opacity: .45; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
+@keyframes backdrop-enter { from { opacity: 0; } to { opacity: 1; } }
+@keyframes dialog-enter { from { opacity: 0; transform: scale(.985); } to { opacity: 1; transform: scale(1); } }
+@keyframes seat-select { 50% { transform: scale(1.055); } }
+@media (max-width: 600px) {
+  .movies-home .card-copy { padding: 9px 10px 6px; }
+  .movies-home .card-action { padding: 0 10px 8px; }
+  .location-button { min-height: 44px; }
+  .graphical-footer .footer-content { padding-inline: 12px; gap: 4px; }
+  .footer-graphic > span { font-size: 10px; max-width: 105px; }
+  .listing-detail-art { aspect-ratio: 16 / 9; }
+  .listing-feature-copy { padding: 22px 18px; }
+  .listing-facts dl { gap: 18px 24px; }
+  .listing-availability { padding: 24px 18px; flex-direction: column; align-items: stretch; }
+}
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after { animation: none !important; transition: none !important; scroll-behavior: auto !important; }
+  .movie-card:hover, .movie-card:focus-within, .demo-listing:hover, .demo-listing:focus-within, .footer-graphic:hover, .footer-graphic:focus-visible,
+  .movie-card:hover .poster img, .movie-card:focus-within .poster img, .demo-listing:hover .demo-listing-art img, .demo-listing:focus-within .demo-listing-art img,
+  .btn:active, .secondary:active, .icon-button:active, .danger-outline:active, .seat:not(:disabled):hover, .seat:active { transform: none; }
+}

