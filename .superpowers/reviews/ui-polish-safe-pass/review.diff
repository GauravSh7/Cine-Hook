+    {checkout ? <><p className="font-semibold">Have a coupon?</p><div className="mt-3 flex gap-3"><label className="sr-only" htmlFor="coupon">Coupon code</label><input id="coupon" className="input" placeholder="Coupons are not enabled" disabled /><button className="secondary" disabled>Apply</button></div><p className="muted mt-3 text-xs">No extra fees apply. Coupons are currently unavailable.</p></>
